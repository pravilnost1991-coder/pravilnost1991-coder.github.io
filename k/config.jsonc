// fastfetch для ivan@kabina — логотип «VIVO SEROST' SHAYBA TAPKI ULTRA»
// второй логотип (ADB ROOT) показывается командой: adbroot
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": { "keys": "magenta", "title": "magenta" }
  },
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/tapki.txt",
    "padding": { "top": 1, "right": 3 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    { "type": "host", "key": "Model", "format": "VIVO SEROST' SHAYBA TAPKI ULTRA" },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
